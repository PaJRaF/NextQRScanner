<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. The encrypted scan database and the keystore-
     backed preferences are excluded so sensitive history never leaves the
     device via cloud/device-transfer backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="nextqr-scans.db" />
        <exclude domain="database" path="nextqr-scans.db-wal" />
        <exclude domain="database" path="nextqr-scans.db-shm" />
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="nextqr-scans.db" />
        <exclude domain="sharedpref" path="secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>

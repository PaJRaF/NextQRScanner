# Copy this file to `keystore.properties` (git-ignored) and fill in real values,
# or provide the same keys as environment variables in CI.
#
# NONE of these values are ever committed. In CI they are provided via encrypted
# GitHub Actions secrets and materialised into keystore.properties at build time.

# --- Release signing (Play App Signing upload key) ---
storeFile=../release-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME

# --- Google Safe Browsing API key (URL reputation checks) ---
SAFE_BROWSING_API_KEY=CHANGE_ME

# --- AdMob application id (from AdMob console) ---
# The value below is Google's official TEST app id — safe for development.
ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
